---
import { note, hardware, hardwareDate } from '../data/note';

const fmt = (t: string) => t.replace(/`([^`]+)`/g, '<code>$1</code>');

const devices = [
  {
    key: 'printer',
    label: 'Imprimante 3D',
    title: 'Imprimante 3D',
    text: "La seule machine que l'on peut lancer à distance. Coupure automatique à la fin de l'impression ou en cas de surchauffe.",
  },
  {
    key: 'laser',
    label: 'Découpeuse laser',
    title: 'Découpeuse laser',
    text: "Suivie en lecture seule : statut et qualité de l'air. Jamais de démarrage à distance, à cause du risque d'incendie. Un maker peut y envoyer un fichier à l'avance, mais seul un geste sur place le libère.",
  },
  {
    key: 'plug',
    label: 'Prises Zigbee',
    title: 'Prise Sonoff S60ZBTPF',
    text: "Elle mesure la puissance (libre, en marche, en panne) et, pour l'imprimante, coupe ou rétablit le courant sans toucher au 230 V.",
  },
  {
    key: 'presence',
    label: 'Capteur de présence',
    title: 'Capteur de présence Sonoff SNZB-06P',
    text: "Un radar qui voit aussi les personnes immobiles. Il indique si l'atelier est occupé et déclenche une alerte si une machine tourne alors que personne n'est là.",
  },
  {
    key: 'air',
    label: "Capteur d'air",
    title: 'Moniteur UTTASU 5 en 1 (Tuya, Zigbee)',
    text: "Particules fines PM2.5, COV, température et humidité (CO2 annoncé, à vérifier) près de la laser. Au-dessus du seuil, le fabmanager est alerté.",
  },
  {
    key: 'hub',
    label: 'Raspberry Pi',
    title: 'Raspberry Pi + clé ZBDongle-E',
    text: "Il héberge Zigbee2MQTT, Mosquitto, le worker et la base de données. C'est le seul appareil relié au réseau de l'école.",
  },
];

const nav = [
  ['accueil', 'Accueil'],
  ['projet', 'Projet'],
  ['systeme', 'Système'],
  ['materiel', 'Matériel'],
  ['ia', 'IA'],
];

---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Fabio, le compagnon connecté du fablab : machines en direct, réservation, qualité de l'air, tout en Zigbee." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <title>Fabio — Le compagnon de fablab</title>
  </head>
  <body>
    <header class="nav" id="nav">
      <a class="brand" href="#accueil"><img src="/favicon.svg?v=2" alt="" width="36" height="36" />Fabio<span>.</span></a>
      <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="menu" aria-label="Sections de la page">
        <ul>
          {nav.map(([id, label]) => <li><a href={`#${id}`} data-spy={id}>{label}</a></li>)}
        </ul>
      </nav>
    </header>

    <main>
      <!-- ACCUEIL -->
      <section id="accueil" class="hero">
        <div class="hero-text">
          <h1>Fabio<span>.</span></h1>
          <p class="lead">{note.title}</p>
          <p class="cta">
            <a class="btn primary" href="#systeme">Voir le système</a>
            <a class="btn" href="#materiel">Le matériel</a>
          </p>
          <ul class="stats">
            <li><b>100 %</b> Zigbee</li>
            <li><b>4</b> pièces à brancher</li>
            
          </ul>
        </div>
        <div class="hero-3d">
          <canvas id="fabi-canvas" role="img" aria-label="Fabi, la mascotte de Fabio, en 3D, entourée des capteurs du projet"></canvas>
        </div>
      </section>

      <!-- PROJET -->
      <section id="projet">
        <h2>Un compagnon pour tout le fablab</h2>
        <p class="sentence">« {note.validation.sentence} »</p>
        <div class="trio">
          <article style="--c:#4dabf7">
            <h3>📱 Makers</h3><p class="who">application mobile</p>
            <ul>{note.mobile.map((t) => <li>{t}</li>)}</ul>
          </article>
          <article style="--c:#ffd43b">
            <h3>🖥️ Fabmanager</h3><p class="who">back-office web</p>
            <ul>{note.backoffice.map((t) => <li>{t}</li>)}</ul>
          </article>
          <article style="--c:#ff6b6b">
            <h3>🌐 Tout le monde</h3><p class="who">site vitrine</p>
            <ul>{note.vitrine.map((t) => <li>{t}</li>)}</ul>
          </article>
        </div>
      </section>

      <!-- SYSTÈME -->
      <section id="systeme" class="tinted">
        <h2>Comment ça marche</h2>
        <p class="intro">
          Toutes les pièces parlent Zigbee à une seule clé, branchée sur un Raspberry Pi.
          Fais tourner l'atelier en le faisant glisser, puis clique un objet pour le découvrir.
        </p>
        <div class="dio-wrap">
          <div class="dio" id="dio"></div>
          <div class="dio-side">
            <div class="dio-info" id="dio-info" aria-live="polite">
              <h3>Clique un objet</h3>
              <p>Chaque objet de l'atelier est une vraie pièce du projet. Les impulsions jaunes sont les messages Zigbee qui remontent vers le Raspberry Pi.</p>
            </div>
            <ul class="dio-legend" id="dio-legend">
              {devices.map((d) => <li><button type="button" data-key={d.key}>{d.label}</button></li>)}
            </ul>
          </div>
        </div>

        <ol class="flow" aria-label="Chemin des données">
          <li><b>1</b><span>Capteurs et prises</span><small>mesurent et obéissent</small></li>
          <li><b>2</b><span>Réseau Zigbee</span><small>local, sans cloud</small></li>
          <li><b>3</b><span>Raspberry Pi</span><small>Zigbee2MQTT, MQTT, base de données</small></li>
          <li><b>4</b><span>Les applis</span><small>mobile, back-office, site</small></li>
        </ol>

        <aside class="files">
          <h3>📂 Envoi de fichiers à la découpeuse <small>piste à étudier</small></h3>
          <ol>
            <li>Le maker dépose son fichier dans l'application : il reste « en attente » sur le Raspberry Pi, lié à sa réservation.</li>
            <li>Sur place, un geste volontaire (validation sur le poste ou sur la machine) libère le fichier.</li>
            <li>Le lancement reste manuel, sur la machine : jamais de démarrage à distance.</li>
          </ol>
          <p>Le mode de transfert exact (clé USB, dossier partagé, réseau) dépend du modèle de la découpeuse, encore à identifier.</p>
        </aside>
      </section>

      <!-- MATÉRIEL -->
      <section id="materiel">
        <h2>Le matériel</h2>
        <p class="intro">Quatre pièces, tout en Zigbee. Prix relevés le {hardwareDate} : vérifie-les avant de commander.</p>
        <div class="hw-grid">
          {hardware.map((h) => (
            <article class="hw" style={`--c:${h.color}`}>
              <div class="hw-top">
                <span class="icon" aria-hidden="true">{h.icon}</span>
                <div>
                  <p class="cat">{h.category}</p>
                  <h3>{h.name}</h3>
                </div>
              </div>
              <p class="status">{h.status}</p>
              <ul>{h.why.slice(0, 3).map((t) => <li set:html={fmt(t)} />)}</ul>
              <details>
                <summary>Plus de détails et points d'attention</summary>
                <ul>{h.why.slice(3).map((t) => <li set:html={fmt(t)} />)}</ul>
                <p class="watch-title">À surveiller</p>
                <ul class="watch">{h.watch.map((t) => <li set:html={fmt(t)} />)}</ul>
              </details>
              <p class="price"><span>Prix relevés</span>{h.price}</p>
              <ul class="links">
                {h.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a></li>)}
              </ul>
            </article>
          ))}
        </div>

      </section>


      <!-- IA -->
      <section id="ia">
        <h2>L'IA conseille, les règles décident</h2>
        <div class="duo">
          {note.ai.map((a) => (
            <article>
              <p class="who">{a.who}</p>
              <h3>✨ {a.label}</h3>
              <p>{a.text}</p>
            </article>
          ))}
        </div>
        <div class="code-wrap">
          <p class="who">Exemple de règle produite par le modèle (valeurs d'exemple)</p>
          <pre class="code"><code>{`{
  "capteur": "particules_pm25",
  "condition": "superieur_a",
  "seuil": 35,
  "action": "notifier",
  "canal": "mobile"
}`}</code></pre>
          <p class="guard">🔒 {note.guardrail}</p>
        </div>
      </section>

    </main>

    <footer>
      <p><b>Fabio<span>.</span></b> · maquette de présentation · prix relevés le {hardwareDate}</p>
    </footer>

    <script is:inline define:vars={{ devices }}>
      window.__devices = devices;
    </script>
    <script>
      import { initFabi } from '../scripts/fabi3d';
      import { initDiorama } from '../scripts/diorama';
      import type { DeviceInfo } from '../scripts/diorama';

      const devices = (window as unknown as { __devices: DeviceInfo[] }).__devices;

      // ----- navbar : menu mobile et section active -----
      const burger = document.getElementById('burger')!;
      const nav = document.getElementById('nav')!;
      burger.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        burger.setAttribute('aria-expanded', String(open));
      });
      document.querySelectorAll<HTMLAnchorElement>('#menu a').forEach((a) =>
        a.addEventListener('click', () => {
          nav.classList.remove('open');
          burger.setAttribute('aria-expanded', 'false');
        }),
      );
      const links = new Map(
        [...document.querySelectorAll<HTMLAnchorElement>('[data-spy]')].map((a) => [a.dataset.spy!, a]),
      );
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              links.forEach((a) => a.removeAttribute('aria-current'));
              links.get(e.target.id)?.setAttribute('aria-current', 'true');
            }
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      links.forEach((_, id) => {
        const el = document.getElementById(id);
        if (el) spy.observe(el);
      });
      const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // ----- scènes 3D (si WebGL est disponible) -----
      function webgl() {
        try {
          const c = document.createElement('canvas');
          return !!(c.getContext('webgl2') || c.getContext('webgl'));
        } catch {
          return false;
        }
      }
      const info = document.getElementById('dio-info')!;
      const legend = document.getElementById('dio-legend')!;
      const defaultInfo = info.innerHTML;

      function show(i: DeviceInfo | null) {
        if (i) {
          info.innerHTML = '';
          const h = document.createElement('h3');
          h.textContent = i.title;
          const p = document.createElement('p');
          p.textContent = i.text;
          info.append(h, p);
        } else {
          info.innerHTML = defaultInfo;
        }
        legend.querySelectorAll('button').forEach((b) =>
          b.setAttribute('aria-pressed', String(!!i && b.dataset.key === i.key)),
        );
      }

      if (webgl()) {
        initFabi(document.getElementById('fabi-canvas') as HTMLCanvasElement);
        const dio = initDiorama(document.getElementById('dio')!, devices, show);
        legend.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
          b.addEventListener('click', () => {
            const pressed = b.getAttribute('aria-pressed') === 'true';
            dio.select(pressed ? null : b.dataset.key!);
          }),
        );
      } else {
        document.querySelector('.hero-3d')!.classList.add('no3d');
        document.getElementById('dio')!.classList.add('no3d');
        legend.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
          b.addEventListener('click', () => show(devices.find((d) => d.key === b.dataset.key) ?? null)),
        );
      }

    </script>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1b1535;
    --violet: #6741d9;
    --bg: #fff8ee;
    --pink: #ff6b6b;
    --blue: #4dabf7;
    --yellow: #ffd43b;
    --green: #69db7c;
    --soft: #efe9ff;
    --nav-h: 4.2rem;
    --w: 72rem;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: system-ui, 'Segoe UI', Roboto, sans-serif; line-height: 1.55; }
  section { scroll-margin-top: var(--nav-h); padding: 5rem 1.25rem; max-width: 100%; }
  section > *, section > ul, section > ol { max-width: var(--w); margin-left: auto; margin-right: auto; }
  section.tinted { background: var(--soft); }
  h1, h2, h3, p { margin-top: 0; }
  h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.1; font-weight: 900; letter-spacing: -0.02em; margin-bottom: 1rem; }
  h3 { font-size: 1.15rem; margin-bottom: 0.3rem; }
  ul, ol { margin: 0; padding-left: 1.1rem; }
  li { margin-bottom: 0.35rem; }
  code { background: var(--soft); border-radius: 6px; padding: 0.05em 0.35em; font-size: 0.9em; }
  section > .intro { font-size: 1.1rem; max-width: 46rem; margin-bottom: 2rem; color: #3b3560; margin-left: max(0px, calc((100% - var(--w)) / 2)); margin-right: auto; }
  .who { color: #6b6785; font-size: 0.85rem; font-weight: 700; margin-bottom: 0.6rem; }
  .note { font-size: 0.88rem; color: #4a4570; }

  /* boutons */
  .btn { display: inline-block; font: inherit; font-weight: 800; color: var(--ink); background: #fff; border: 3px solid var(--ink); border-radius: 999px; padding: 0.6rem 1.3rem; text-decoration: none; cursor: pointer; box-shadow: 3px 3px 0 var(--ink); transition: transform .12s, box-shadow .12s; }
  .btn:hover { transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--ink); }
  .btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
  .btn.primary { background: var(--yellow); }
  .btn.danger { background: var(--pink); }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid var(--violet); outline-offset: 3px; }

  /* navbar */
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0 1.25rem; background: transparent; transition: background .2s, box-shadow .2s; }
  .nav.scrolled, .nav.open { background: rgba(255, 248, 238, .92); backdrop-filter: blur(10px); box-shadow: 0 3px 0 var(--ink); }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1.7rem; font-weight: 900; letter-spacing: -0.03em; color: #fff; text-decoration: none; }
  .brand img { display: block; width: 2.2rem; height: 2.2rem; }
  .brand span { color: var(--yellow); }
  .nav.scrolled .brand, .nav.open .brand { color: var(--ink); }
  .nav.scrolled .brand span, .nav.open .brand span { color: var(--violet); }
  #menu ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.2rem; }
  #menu li { margin: 0; }
  #menu a { display: block; padding: 0.4rem 0.85rem; border-radius: 999px; color: #fff; font-weight: 700; font-size: 0.95rem; text-decoration: none; border: 2px solid transparent; }
  .nav.scrolled #menu a { color: var(--ink); }
  #menu a:hover { border-color: currentColor; }
  #menu a[aria-current='true'] { background: var(--yellow); color: var(--ink); border-color: var(--ink); }
  .burger { display: none; width: 2.8rem; height: 2.8rem; padding: 0; background: #fff; border: 3px solid var(--ink); border-radius: 50%; cursor: pointer; flex-direction: column; align-items: center; justify-content: center; gap: 4px; }
  .burger span { display: block; width: 18px; height: 3px; background: var(--ink); border-radius: 2px; }

  /* hero */
  .hero { min-height: 100vh; padding-top: calc(var(--nav-h) + 2rem); background: var(--violet); color: #fff; display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 1rem; max-width: 100%; border-radius: 0 0 48px 48px; position: relative; overflow: hidden; }
  .hero::before, .hero::after { content: ''; position: absolute; border-radius: 50%; z-index: 0; }
  .hero::before { width: 26rem; height: 26rem; background: var(--pink); top: -9rem; left: -8rem; }
  .hero::after { width: 18rem; height: 18rem; background: var(--yellow); bottom: -7rem; right: 8%; }
  .hero > * { position: relative; z-index: 1; margin: 0; max-width: none; }
  .hero-text { padding-left: max(0rem, calc((100vw - var(--w)) / 2)); }
  .hero h1 { font-size: clamp(4.5rem, 14vw, 9rem); line-height: .95; margin: 0 0 0.8rem; font-weight: 900; letter-spacing: -0.05em; }
  .hero h1 span { color: var(--yellow); }
  .lead { font-size: clamp(1.15rem, 2.6vw, 1.6rem); font-weight: 700; line-height: 1.25; max-width: 24ch; margin-bottom: 1.6rem; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-bottom: 1.6rem; }
  .stats { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .stats li { margin: 0; background: rgba(255,255,255,.16); border-radius: 999px; padding: 0.35rem 1rem; font-size: 0.9rem; }
  .stats b { font-weight: 900; color: var(--yellow); }
  .hero-3d { height: min(34rem, 70vh); min-height: 20rem; }
  #fabi-canvas { width: 100%; height: 100%; display: block; }
  .no3d { display: none; }

  /* projet */
  .sentence { font-size: clamp(1.3rem, 3vw, 2rem); font-weight: 800; line-height: 1.25; max-width: 40rem; margin-bottom: 2.5rem; }
  .trio, .duo { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1.4rem; }
  .trio article, .duo article { background: #fff; border: 3px solid var(--ink); border-radius: 26px; padding: 1.3rem 1.4rem; box-shadow: 5px 5px 0 var(--ink); }
  .trio article { border-top: 14px solid var(--c); }
  .duo article { background: var(--soft); }
  .trio h3 { margin-top: 0; }

  /* système */
  .dio-wrap { display: grid; grid-template-columns: 1.7fr 1fr; gap: 1.4rem; align-items: stretch; }
  .dio { position: relative; height: 34rem; background: #fff; border: 3px solid var(--ink); border-radius: 32px; box-shadow: 6px 6px 0 var(--ink); overflow: hidden; background-image: radial-gradient(#e7e1f6 1.5px, transparent 1.5px); background-size: 22px 22px; }
  .dio canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .dio-labels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .dio-tag { background: #fff; color: var(--ink); border: 2px solid var(--ink); border-radius: 999px; padding: 0.1rem 0.6rem; font-size: 0.72rem; font-weight: 800; white-space: nowrap; transform: translateY(-4px); }
  .dio.no3d { display: grid; place-items: center; min-height: 8rem; height: auto; }
  .dio.no3d::before { content: 'La scène 3D n\'est pas disponible sur cet appareil : utilise la liste des objets.'; padding: 1rem; text-align: center; }
  .dio-side { display: flex; flex-direction: column; gap: 1rem; }
  .dio-info { background: var(--yellow); border: 3px solid var(--ink); border-radius: 26px; padding: 1.2rem 1.3rem; box-shadow: 5px 5px 0 var(--ink); flex: 1; }
  .dio-info h3 { margin-top: 0; font-size: 1.3rem; }
  .dio-info p { margin-bottom: 0; }
  .dio-legend { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .dio-legend li { margin: 0; }
  .dio-legend button { font: inherit; font-size: 0.88rem; font-weight: 800; color: var(--ink); background: #fff; border: 2px solid var(--ink); border-radius: 999px; padding: 0.35rem 0.9rem; cursor: pointer; }
  .dio-legend button[aria-pressed='true'], .dio-legend button:hover { background: var(--ink); color: #fff; }
  .flow { list-style: none; padding: 0; margin-top: 2.5rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.4rem; counter-reset: s; }
  .flow li { position: relative; margin: 0; background: #fff; border: 3px solid var(--ink); border-radius: 22px; padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.15rem; }
  .flow li:not(:last-child)::after { content: '→'; position: absolute; right: -1.25rem; top: 50%; transform: translateY(-50%); font-size: 1.6rem; font-weight: 900; color: var(--violet); }
  .flow b { display: grid; place-items: center; width: 2rem; height: 2rem; background: var(--violet); color: #fff; border-radius: 50%; margin-bottom: 0.3rem; }
  .flow span { font-weight: 800; }
  .flow small { color: #5a5578; }

  .files { margin-top: 2rem; background: #fff; border: 3px dashed var(--ink); border-radius: 26px; padding: 1.2rem 1.5rem; }
  .files h3 small { background: var(--yellow); border: 2px solid var(--ink); border-radius: 999px; padding: 0.05rem 0.6rem; font-size: 0.72rem; margin-left: 0.4rem; vertical-align: middle; }
  .files p { margin: 0.6rem 0 0; color: #4a4570; font-size: 0.92rem; }

  /* matériel */
  .hw-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 31rem), 1fr)); gap: 1.4rem; }
  .hw { background: #fff; border: 3px solid var(--ink); border-radius: 26px; border-top: 14px solid var(--c); padding: 1.3rem 1.4rem; box-shadow: 6px 6px 0 var(--ink); display: flex; flex-direction: column; }
  .hw-top { display: flex; gap: 0.9rem; align-items: center; }
  .icon { display: grid; place-items: center; flex: none; width: 3.1rem; height: 3.1rem; border-radius: 50%; background: var(--c); border: 3px solid var(--ink); font-size: 1.4rem; }
  .cat { margin: 0; font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; color: #6b6785; }
  .hw h3 { margin: 0; line-height: 1.2; }
  .status { align-self: flex-start; margin: 0.8rem 0; background: var(--ink); color: #fff; border-radius: 999px; padding: 0.2rem 0.85rem; font-size: 0.82rem; font-weight: 700; }
  .hw li { font-size: 0.95rem; }
